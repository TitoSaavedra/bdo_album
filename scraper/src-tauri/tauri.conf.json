{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDO Dashboard",
  "version": "0.1.0",
  "identifier": "com.bdo.dashboard",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BDO Dashboard",
        "width": 1600,
        "height": 1100,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMDhBQjQ0OTIyODFERTcKUldUbkhTaVNSS3NJZzRmM1o3RmVzWEJKdzZUMXNPUUhpOHlkSy9TZ2VqZUhKUEZWMUN2bUVjVkYK",
      "endpoints": [
        "https://github.com/TitoSaavedra/bdo_album/releases/latest/download/scraper-latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "resources": [".env"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
