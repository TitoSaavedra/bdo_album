DATABASE_URL=postgresql://bdo_album:CHANGE_ME@localhost:5432/bdo_album
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bdo-album
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Only download_daemon needs this — scrape only hits Garmoth's public
# search-advanced API. Copied here from the Windows GUI, see README.md §3.
GARMOTH_SESSION_FILE=/opt/bdo-scraper/garmoth_auth.json

# Only needed if the bootstrap CLI isn't at the default location
# (./tools/playwright-rs-cli/bin/playwright-rs, relative to this binary) —
# see README.md §2.
# PLAYWRIGHT_RS_CLI_PATH=/opt/bdo-scraper/tools/playwright-rs-cli/bin/playwright-rs
