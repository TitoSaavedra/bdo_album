{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDO Album",
  "version": "0.2.3",
  "identifier": "com.bdo.album",
  "build": {
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BDO Album",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": { "enable": true, "scope": ["$DOCUMENT/Black Desert/**"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMDhBQjQ0OTIyODFERTcKUldUbkhTaVNSS3NJZzRmM1o3RmVzWEJKdzZUMXNPUUhpOHlkSy9TZ2VqZUhKUEZWMUN2bUVjVkYK",
      "endpoints": [
        "https://github.com/TitoSaavedra/bdo_album/releases/latest/download/album-latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
